# Source-only proposal; coordinator must measure capacity and record built digest.
# Reuse the verified editor distribution solely for its bundled Node binary.
FROM debian@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392 AS unpack
COPY code-server-4.145.2-linux-amd64.tar.gz /tmp/code-server.tar.gz
RUN echo '2f6db6c3e8b733dd6b3aeee83532e148b2bae2e392353ba85452d03572348962  /tmp/code-server.tar.gz' | sha256sum -c - \
    && mkdir /node \
    && tar -xzf /tmp/code-server.tar.gz --strip-components=2 -C /node code-server-4.145.2-linux-amd64/lib/node

FROM debian@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392
ARG EDITOR_UID=1001
ARG EDITOR_GID=1001
RUN apt-get update \
    && apt-get install -y --no-install-recommends libstdc++6 libatomic1 \
    && rm -rf /var/lib/apt/lists/* \
    && test "$EDITOR_UID" -ge 1000 && test "$EDITOR_GID" -ge 1000 \
    && groupadd -g "$EDITOR_GID" relay \
    && useradd --uid "$EDITOR_UID" --gid "$EDITOR_GID" --no-create-home --shell /usr/sbin/nologin relay \
    && mkdir -p /run/homeai-editor /run/homeai-transport /opt/homeai
COPY --from=unpack --chown=0:0 /node/node /usr/local/bin/node
COPY --chown=0:0 socket-relay.cjs /opt/homeai/socket-relay.cjs
USER ${EDITOR_UID}:${EDITOR_GID}
# A supplies --port <assigned>; runtime must enforce hostnetwork only in the
# trusted guest relay, read-only root, cap-drop ALL, no-new-privileges, 64MiB
# RAM/zero swap, 0.25 CPU, 64 PIDs, own socket directory RO and dedicated
# transport certificate directory RO at /run/homeai-transport containing only
# server.crt/server.key/ca.crt. CA must be unique to scope+generation; only the
# trusted host broker receives the signed client key. No CA private key here.
# TLSv1.3 mTLS is mandatory before opening the editor's UNIX socket.
# No workspace, editor home, Docker socket, owner credentials or other binds.
ENTRYPOINT ["/usr/local/bin/node", "/opt/homeai/socket-relay.cjs"]
